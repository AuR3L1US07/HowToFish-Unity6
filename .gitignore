# Unity never imports folders ending in '~' (no .meta = not part of the asset database).
# Exclude the bulky, non-functional ones from embedded packages to keep the repo lean.
/Packages/**/Documentation~/
/Packages/**/Samples~/
/Packages/**/Tools~/
